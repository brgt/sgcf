<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sgcf.Domain — Pure domain layer.
    Rules:
    - ZERO infrastructure dependencies (no EF, no HTTP, no logging frameworks).
    - The only allowed NuGet package is NodaTime (for temporal domain types).
    - All financial calculations must be pure functions (no I/O, no side effects).
    - Money amounts must use the Money value object — never raw decimal.
    - Use NodaTime LocalDate/Instant instead of DateTime/DateTimeOffset.
  -->

  <PropertyGroup>
    <RootNamespace>Sgcf.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- NodaTime: domain-safe temporal types (LocalDate, Instant, Period, etc.) -->
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!--
      InternalsVisibleTo para Sgcf.Application:
      Contrato.VincularPoliticaBanco é internal por design (SPEC §3.5, invariante SC-05) —
      não deve ser chamado por terceiros, apenas pelo handler de conversão cotação→contrato.
      Expor como public violaria o princípio de menor privilégio sem necessidade: a única
      camada legítima para invocar esse método é Sgcf.Application.
    -->
    <InternalsVisibleTo Include="Sgcf.Application" />
    <!--
      InternalsVisibleTo para Sgcf.Application.Tests:
      Permite que os testes unitários do handler acessem VincularPoliticaBanco diretamente
      para verificar o estado do contrato após a chamada (white-box testing).
    -->
    <InternalsVisibleTo Include="Sgcf.Application.Tests" />
  </ItemGroup>

</Project>
